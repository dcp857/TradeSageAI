# Copy this file to .env and fill in real values. Never commit the real .env
# (it's already covered by .gitignore).

# --- Actually read by backend/app.py today ---
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///tradesage.db
# For PostgreSQL (target deployment): postgresql://user:password@host:5432/tradesage

# --- Live Sentiment Data Sources ---
# Read by backend/sentiment_service.py for stock and crypto sentiment.
# If unset or failing, the app returns neutral sentiment (0.0) without crashing (SRS NFR-2)
# and flags the data source as degraded in Admin data-source health.
# Free-tier NewsAPI key for stock news headlines (https://newsapi.org):
NEWSAPI_KEY=
# Reddit API credentials for crypto posts in r/CryptoCurrency (https://www.reddit.com/prefs/apps):
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tradesage-ai/1.0

# --- Reserved for optional future live broker integrations ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Runtime configuration ---
# FLASK_DEBUG=1 enables debug mode (development only). Leave unset for production.
# SEED_DEMO_USER=1 causes the app to seed a demo user (trader@tradesage.ai / Password123!)
#    at startup so the 1-click demo login works. Set to anything else/empty to hide the button.
FLASK_DEBUG=
SEED_DEMO_USER=
